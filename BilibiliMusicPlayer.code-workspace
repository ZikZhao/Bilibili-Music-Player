{
  "folders": [
    {
      "name": "BilibiliMusicPlayer",
      "path": "."
    }
  ],
  "settings": {
    "dart.projectSearchDepth": 3,
    "dart.runPubGetOnPubspecChanges": "always",
    "dart.flutterCreateOrganization": "com.bmp",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "[dart]": {
      "editor.formatOnSave": true,
      "editor.formatOnType": true,
      "editor.rulers": [80, 120],
      "editor.selectionHighlight": false,
      "editor.suggestSelection": "first",
      "editor.tabCompletion": "onlySnippets",
      "editor.wordBasedSuggestions": "off",
      "editor.defaultFormatter": "Dart-Code.dart-code"
    },
    "files.associations": {
      "*.arb": "json"
    },
    "files.exclude": {
      "**/.dart_tool": true,
      "**/.idea": true,
      "**/build": true,
      "**/*.g.dart": false
    },
    "search.exclude": {
      "**/build": true,
      "**/.dart_tool": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "flutter: pub get",
        "type": "shell",
        "command": "flutter pub get",
        "options": {
          "cwd": "${workspaceFolder}/mobile"
        },
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "flutter: build_runner",
        "type": "shell",
        "command": "dart run build_runner build --delete-conflicting-outputs",
        "options": {
          "cwd": "${workspaceFolder}/mobile"
        },
        "group": "build",
        "problemMatcher": [],
        "dependsOn": ["flutter: pub get"]
      },
      {
        "label": "flutter: clean & rebuild",
        "type": "shell",
        "command": "flutter clean && flutter pub get && dart run build_runner build --delete-conflicting-outputs",
        "options": {
          "cwd": "${workspaceFolder}/mobile"
        },
        "group": "build",
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.1.0",
    "configurations": [
      {
        "name": "Mobile: Debug",
        "type": "dart",
        "request": "launch",
        "program": "lib/main.dart",
        "cwd": "${workspaceFolder}/mobile",
        "preLaunchTask": "flutter: pub get",
        "args": []
      },
      {
        "name": "Mobile: Profile",
        "type": "dart",
        "request": "launch",
        "program": "lib/main.dart",
        "cwd": "${workspaceFolder}/mobile",
        "flutterMode": "profile"
      },
      {
        "name": "Mobile: Release",
        "type": "dart",
        "request": "launch",
        "program": "lib/main.dart",
        "cwd": "${workspaceFolder}/mobile",
        "flutterMode": "release"
      }
    ],
    "compounds": []
  },
  "extensions": {
    "recommendations": [
      "Dart-Code.dart-code",
      "Dart-Code.flutter",
      "usernamehw.errorlens",
      "pflannery.vscode-versionlens"
    ]
  }
}
