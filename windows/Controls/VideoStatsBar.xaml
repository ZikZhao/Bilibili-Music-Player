<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="bilibili_music_player_windows.Controls.VideoStatsBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:bilibili_music_player_windows.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource Slate50}" CornerRadius="12" Padding="16,12">
        <Grid ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 播放 -->
            <StackPanel Spacing="2" HorizontalAlignment="Center">
                <TextBlock Text="播放" Foreground="{ThemeResource Slate400}" FontSize="10" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewCount, Mode=OneWay}"
                           Foreground="{ThemeResource Slate800}" FontWeight="SemiBold" FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 点赞 -->
            <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center">
                <TextBlock Text="点赞" Foreground="{ThemeResource Slate400}" FontSize="10" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind LikeCount, Mode=OneWay}"
                           Foreground="{ThemeResource Slate800}" FontWeight="SemiBold" FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 收藏数 -->
            <StackPanel Grid.Column="2" Spacing="2" HorizontalAlignment="Center">
                <TextBlock Text="收藏数" Foreground="{ThemeResource Slate400}" FontSize="10" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind FavoriteCount, Mode=OneWay}"
                           Foreground="{ThemeResource Slate800}" FontWeight="SemiBold" FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 硬币 -->
            <StackPanel Grid.Column="3" Spacing="2" HorizontalAlignment="Center">
                <TextBlock Text="硬币" Foreground="{ThemeResource Slate400}" FontSize="10" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind CoinCount, Mode=OneWay}"
                           Foreground="{ThemeResource Slate800}" FontWeight="SemiBold" FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 时长 -->
            <StackPanel Grid.Column="4" Spacing="2" HorizontalAlignment="Center">
                <TextBlock Text="时长" Foreground="{ThemeResource Slate400}" FontSize="10" HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind Duration, Mode=OneWay}"
                           Foreground="{ThemeResource Slate800}" FontWeight="SemiBold" FontSize="12"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
