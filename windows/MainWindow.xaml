<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="bilibili_music_player_windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:bilibili_music_player_windows"
    xmlns:helpers="using:bilibili_music_player_windows"
    xmlns:controls="using:bilibili_music_player_windows.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="BiliMusic Desktop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ Custom Title Bar (U5) ═══ -->
        <Grid Height="40" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="TitleBackButton" Width="28" Height="28" Padding="0" CornerRadius="4"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource SubtleButtonStyle}" IsEnabled="False"
                    Click="OnTitleBackClick" ToolTipService.ToolTip="返回 (Alt+←)"
                    AutomationProperties.Name="返回" AutomationProperties.AutomationId="TitleBackButton">
                <FontIcon Glyph="&#xE72B;" FontSize="12" />
            </Button>
            <Grid x:Name="AppTitleBar" Grid.Column="1" Background="Transparent">
                <TextBlock x:Name="TitleBarText" Text="BiliMusic Desktop"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource Slate600}" VerticalAlignment="Center" Margin="8,0,0,0"
                           AutomationProperties.AutomationId="TitleBarText" />
            </Grid>
        </Grid>

        <!-- ═══ NavigationView (U1) + Content + Now-Playing Bar ═══ -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="LeftCompact"
                        OpenPaneLength="48"
                        CompactPaneLength="48"
                        IsPaneToggleButtonVisible="False"
                        IsPaneOpen="False"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="OnNavSelectionChanged"
                        AutomationProperties.AutomationId="MainNavigationView">

            <NavigationView.Resources>
                <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="Rose400" />
            </NavigationView.Resources>

            <!-- Main navigation items -->
            <NavigationView.MenuItems>
                <NavigationViewItem Tag="playlist" Content="播放列表"
                                    AutomationProperties.AutomationId="NavPlaylist">
                    <NavigationViewItem.Icon>
                        <controls:Icon Glyph="{StaticResource Icon_MusicList}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="search" Content="搜索"
                                    AutomationProperties.AutomationId="NavSearch">
                    <NavigationViewItem.Icon>
                        <controls:Icon Glyph="{StaticResource Icon_Search}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="favorites" Content="我的收藏"
                                    AutomationProperties.AutomationId="NavFavorites">
                    <NavigationViewItem.Icon>
                        <controls:Icon Glyph="{StaticResource Icon_Like}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="nowplaying" Content="正在播放"
                                    AutomationProperties.AutomationId="NavNowPlaying">
                    <NavigationViewItem.Icon>
                        <controls:Icon Glyph="{StaticResource Icon_Play}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="settings" Content="设置"
                                    AutomationProperties.AutomationId="NavSettings">
                    <NavigationViewItem.Icon>
                        <controls:Icon Glyph="{StaticResource Icon_SettingTwo}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Tabs stay attached to this host; switching only changes Visibility. -->
            <Grid x:Name="ShellContent" AutomationProperties.AutomationId="ShellContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="PageHost" Grid.Row="0" AutomationProperties.AutomationId="ResidentPageHost" />

                <controls:NowPlayingBar x:Name="SharedTransport" Grid.Row="1" DetailsRequested="OnNowPlayingClick" />
                <!-- The expanded player covers the right content and transport,
                     leaving the navigation pane and window title bar available. -->
                <Grid x:Name="PlayerOverlayHost" Grid.RowSpan="2" Canvas.ZIndex="10" Visibility="Collapsed"
                      AutomationProperties.AutomationId="PlayerOverlayHost" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
