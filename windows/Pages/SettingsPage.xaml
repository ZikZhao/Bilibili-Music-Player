<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="bilibili_music_player_windows.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer>
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,32">
                <Rectangle Width="4" Height="24" Fill="{ThemeResource Rose400}" VerticalAlignment="Center" RadiusX="2" RadiusY="2" />
                <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" Foreground="{ThemeResource Slate800}" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="播放" Foreground="{ThemeResource Rose400}" FontWeight="SemiBold" Margin="0,0,0,16" />
            <Border Grid.Row="2" BorderBrush="{ThemeResource Slate100}" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" Background="{ThemeResource Slate100}" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="HQ" Foreground="{ThemeResource Slate600}" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="音频质量" Foreground="{ThemeResource Slate800}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.AudioQuality, Mode=OneWay}" Foreground="{ThemeResource Slate400}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <!-- <ImageIcon Grid.Column="3" Source="ms-appx:///Assets/Icons/forward.svg" Width="16" Height="16" VerticalAlignment="Center" /> -->
                    </Grid>
                    <Border BorderBrush="{ThemeResource Slate50}" BorderThickness="0,1,0,0" />
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" Background="{ThemeResource Slate100}" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- <ImageIcon Source="ms-appx:///Assets/Icons/audio.svg" Width="18" Height="18" /> -->
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="渐变播放" Foreground="{ThemeResource Slate800}" FontWeight="SemiBold" />
                            <TextBlock Text="暂停或开始时音量淡入淡出" Foreground="{ThemeResource Slate400}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="3"
                                      IsOn="{x:Bind ViewModel.EnableFade, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="FadeToggle" />
                    </Grid>
                    <Border BorderBrush="{ThemeResource Slate50}" BorderThickness="0,1,0,0" />
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" Background="{ThemeResource Slate100}" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- <ImageIcon Source="ms-appx:///Assets/Icons/play-sl.svg" Width="18" Height="18" /> -->
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="自动播放" Foreground="{ThemeResource Slate800}" FontWeight="SemiBold" />
                            <TextBlock Text="收藏列表点击后自动开始播放" Foreground="{ThemeResource Slate400}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="3"
                                      IsOn="{x:Bind ViewModel.EnableAutoPlay, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="AutoPlayToggle" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="3" Text="外观" Foreground="{ThemeResource Rose400}" FontWeight="SemiBold" Margin="0,40,0,16" />
            <Border Grid.Row="4" BorderBrush="{ThemeResource Slate200}" BorderThickness="1" CornerRadius="32" Padding="4"
                    AutomationProperties.AutomationId="ThemeModeSelector">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ThemeAutoBg" Grid.Column="0" CornerRadius="24" Padding="0,8"
                            Background="{ThemeResource Rose400}">
                        <TextBlock x:Name="ThemeAutoText" Text="自动" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="White" />
                    </Border>
                    <Border x:Name="ThemeLightBg" Grid.Column="1" CornerRadius="24" Padding="0,8"
                            Background="Transparent">
                        <TextBlock x:Name="ThemeLightText" Text="亮色" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{ThemeResource Slate600}" />
                    </Border>
                    <Border x:Name="ThemeDarkBg" Grid.Column="2" CornerRadius="24" Padding="0,8"
                            Background="Transparent">
                        <TextBlock x:Name="ThemeDarkText" Text="深色" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Foreground="{ThemeResource Slate600}" />
                    </Border>
                    <!-- Transparent click overlays -->
                    <Button Grid.Column="0" Click="OnThemeAutoClick"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            AutomationProperties.AutomationId="ThemeAutoButton" />
                    <Button Grid.Column="1" Click="OnThemeLightClick"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            AutomationProperties.AutomationId="ThemeLightButton" />
                    <Button Grid.Column="2" Click="OnThemeDarkClick"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            AutomationProperties.AutomationId="ThemeDarkButton" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="5" Text="数据与存储" Foreground="{ThemeResource Rose400}" FontWeight="SemiBold" Margin="0,40,0,16" />
            <Border Grid.Row="6" BorderBrush="{ThemeResource Slate100}" BorderThickness="1" CornerRadius="16">
                <Button x:Name="ClearCacheButton" Command="{x:Bind ViewModel.ClearCacheCommand}"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="ClearCacheButton">
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" Background="{ThemeResource Slate100}" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- <ImageIcon Source="ms-appx:///Assets/Icons/folder.svg" Width="18" Height="18" /> -->
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="清除缓存" Foreground="{ThemeResource Slate800}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.CacheSize, Mode=OneWay}" Foreground="{ThemeResource Slate400}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <!-- <ImageIcon Grid.Column="3" Source="ms-appx:///Assets/Icons/delete.svg" Width="20" Height="20" VerticalAlignment="Center" /> -->
                    </Grid>
                </Button>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
