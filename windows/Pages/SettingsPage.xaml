<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="bilibili_music_player_windows.Pages.SettingsPage" Style="{StaticResource AppPageStyle}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:bilibili_music_player_windows.Controls">
    <Page.Resources>
        <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFFB7185" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFFB7185" Opacity="0.9" />
        <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFFB7185" Opacity="0.8" />
        <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="ToggleSwitchFillOn" />
        <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="ToggleSwitchFillOnPointerOver" />
        <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="ToggleSwitchFillOnPressed" />
        <Style x:Key="SettingsSectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource Slate800}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="SettingsRowStyle" TargetType="controls:SettingsRow">
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:SettingsRow">
                        <Grid x:Name="RowLayout" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" ColumnSpacing="24" RowSpacing="12" MinHeight="76">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup>
                                    <VisualState x:Name="CompactRow">
                                        <VisualState.StateTriggers>
                                            <AdaptiveTrigger MinWindowWidth="0" />
                                        </VisualState.StateTriggers>
                                    </VisualState>
                                    <VisualState x:Name="WideRow">
                                        <VisualState.StateTriggers>
                                            <AdaptiveTrigger MinWindowWidth="760" />
                                        </VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Target="RowLayout.RowSpacing" Value="0" />
                                            <Setter Target="RowLabel.(Grid.ColumnSpan)" Value="1" />
                                            <Setter Target="RowControl.(Grid.Row)" Value="0" />
                                            <Setter Target="RowControl.(Grid.Column)" Value="1" />
                                            <Setter Target="RowControl.(Grid.ColumnSpan)" Value="1" />
                                            <Setter Target="RowControl.HorizontalAlignment" Value="Right" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="RowLabel" Grid.ColumnSpan="2" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Title}" Foreground="{ThemeResource Slate800}" TextWrapping="Wrap" />
                                <TextBlock Text="{TemplateBinding Description}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <ContentPresenter x:Name="RowControl" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel x:Name="SettingsPageRoot" Margin="{StaticResource PageContentMargin}" Spacing="28">
            <Grid Margin="0,0,0,4">
                <TextBlock x:Name="PageTitle" Text="设置" Style="{StaticResource PageTitleTextBlockStyle}" AutomationProperties.AutomationId="PageTitle" />
            </Grid>
            <StackPanel>
                <TextBlock Text="账户与收藏" Style="{StaticResource SettingsSectionHeading}" />
                <StackPanel Spacing="4">
                    <controls:SettingsRow Title="邮箱账户" Description="{x:Bind Library.AccountLabel, Mode=OneWay}" Style="{StaticResource SettingsRowStyle}">
                        <Button Content="{x:Bind Library.AccountButtonLabel, Mode=OneWay}" Click="OnAccountClick" IsEnabled="{x:Bind Library.IsReady, Mode=OneWay}" AutomationProperties.AutomationId="SettingsAccountButton" />
                    </controls:SettingsRow>
                    <controls:SettingsRow Title="收藏同步" Description="{x:Bind Library.SyncStatus, Mode=OneWay}" Style="{StaticResource SettingsRowStyle}">
                        <Button Content="立即同步" Click="OnSyncClick" IsEnabled="{x:Bind Library.IsSignedIn, Mode=OneWay}" AutomationProperties.AutomationId="SettingsSyncButton" />
                    </controls:SettingsRow>
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Error" Message="{x:Bind Library.ErrorMessage, Mode=OneWay}" Visibility="{x:Bind Library.ErrorVisibility, Mode=OneWay}" Margin="0,8,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="收藏快速播放" Style="{StaticResource SettingsSectionHeading}" />
                <StackPanel Spacing="4">
                    <controls:SettingsRow Title="触发方式" Description="仅控制歌曲条目，文件夹和歌单仍单击打开。" Style="{StaticResource SettingsRowStyle}">
                        <ComboBox SelectedIndex="{x:Bind ViewModel.QuickPlayGesture, Mode=TwoWay}" MinWidth="180" AutomationProperties.AutomationId="QuickPlayGesture" AutomationProperties.Name="快速播放触发方式">
                            <x:String>单击</x:String>
                            <x:String>双击</x:String>
                            <x:String>关闭快速播放</x:String>
                        </ComboBox>
                    </controls:SettingsRow>
                    <controls:SettingsRow Title="加入范围" Description="整张列表按当前收藏夹的显示顺序加入，从点击的歌曲开始。" Style="{StaticResource SettingsRowStyle}">
                        <ComboBox SelectedIndex="{x:Bind ViewModel.QuickPlayScope, Mode=TwoWay}" MinWidth="180" AutomationProperties.AutomationId="QuickPlayScope" AutomationProperties.Name="快速播放加入范围">
                            <x:String>当前收藏夹全部歌曲</x:String>
                            <x:String>仅点击的歌曲</x:String>
                        </ComboBox>
                    </controls:SettingsRow>
                    <controls:SettingsRow Title="播放列表操作" Description="选择替换列表、追加到末尾，或放在当前歌曲之后。" Style="{StaticResource SettingsRowStyle}">
                        <ComboBox SelectedIndex="{x:Bind ViewModel.QuickPlayDestination, Mode=TwoWay}" MinWidth="180" AutomationProperties.AutomationId="QuickPlayDestination" AutomationProperties.Name="快速播放列表操作">
                            <x:String>覆盖播放列表</x:String>
                            <x:String>追加到队尾</x:String>
                            <x:String>插入到下一首</x:String>
                        </ComboBox>
                    </controls:SettingsRow>
                    <controls:SettingsRow Title="加入后立即播放" Description="开启后切换到点击的歌曲；关闭时追加或插入不会打断当前播放。" Style="{StaticResource SettingsRowStyle}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.EnableAutoPlay, Mode=TwoWay}" OnContent="开" OffContent="关" AutomationProperties.AutomationId="AutoPlayToggle" AutomationProperties.Name="加入后立即播放" />
                    </controls:SettingsRow>
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="播放" Style="{StaticResource SettingsSectionHeading}" />
                <StackPanel Spacing="4">
                    <controls:SettingsRow Title="淡入淡出" Description="开始和暂停时平滑改变音量。音频始终选择可获取的最高质量。" Style="{StaticResource SettingsRowStyle}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.EnableFade, Mode=TwoWay}" OnContent="开" OffContent="关" AutomationProperties.AutomationId="FadeToggle" AutomationProperties.Name="淡入淡出" />
                    </controls:SettingsRow>
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="外观与窗口" Style="{StaticResource SettingsSectionHeading}" />
                <StackPanel Spacing="4">
                    <controls:SettingsRow Title="主题" Description="选择应用的浅色或深色外观。" Style="{StaticResource SettingsRowStyle}">
                        <ComboBox SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" MinWidth="180" AutomationProperties.AutomationId="ThemeIndex" AutomationProperties.Name="主题">
                            <x:String>跟随系统</x:String>
                            <x:String>浅色</x:String>
                            <x:String>深色</x:String>
                        </ComboBox>
                    </controls:SettingsRow>
                    <controls:SettingsRow Title="界面动画" Description="正在播放页以缓动曲线滑入和收起，同时遵循系统的动画设置。" Style="{StaticResource SettingsRowStyle}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.EnableAnimations, Mode=TwoWay}" OnContent="开" OffContent="关" AutomationProperties.AutomationId="AnimationsToggle" AutomationProperties.Name="界面动画" />
                    </controls:SettingsRow>
                    <controls:SettingsRow Title="关闭窗口时" Description="Esc 在顶级页面始终隐藏到后台，托盘菜单可彻底退出。" Style="{StaticResource SettingsRowStyle}">
                        <ComboBox SelectedIndex="{x:Bind ViewModel.CloseBehavior, Mode=TwoWay}" MinWidth="180" AutomationProperties.AutomationId="CloseBehavior" AutomationProperties.Name="关闭窗口时">
                            <x:String>留在后台</x:String>
                            <x:String>退出应用</x:String>
                        </ComboBox>
                    </controls:SettingsRow>
                    <controls:SettingsRow Title="隐藏到后台时暂停" Description="关闭或隐藏窗口后暂停音频，返回时保持暂停。" Style="{StaticResource SettingsRowStyle}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.PauseInBackground, Mode=TwoWay}" OnContent="开" OffContent="关" AutomationProperties.AutomationId="PauseInBackgroundToggle" AutomationProperties.Name="隐藏到后台时暂停" />
                    </controls:SettingsRow>
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="缓存与存储" Style="{StaticResource SettingsSectionHeading}" />
                <StackPanel Spacing="4">
                    <controls:SettingsRow Title="缓存已播放的音频" Description="已缓存的歌曲可直接读取；关闭后不再下载新的音频缓存。" Style="{StaticResource SettingsRowStyle}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.EnableAudioCache, Mode=TwoWay}" OnContent="开" OffContent="关" AutomationProperties.AutomationId="AudioCacheToggle" AutomationProperties.Name="缓存已播放的音频" />
                    </controls:SettingsRow>
                    <controls:SettingsRow Title="音频缓存" Description="{x:Bind ViewModel.CacheSize, Mode=OneWay}" Style="{StaticResource SettingsRowStyle}">
                        <Button Content="清除缓存" Command="{x:Bind ViewModel.ClearCacheCommand}" AutomationProperties.AutomationId="ClearCacheButton" />
                    </controls:SettingsRow>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="设置保存在这台电脑上，账户仅同步收藏。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>