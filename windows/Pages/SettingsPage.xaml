<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="bilibili_music_player_windows.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer>
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,32">
                <Rectangle Width="4" Height="24" Fill="{StaticResource Rose400}" VerticalAlignment="Center" RadiusX="2" RadiusY="2" />
                <TextBlock Text="设置" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Slate800}" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="播放" Foreground="{StaticResource Rose400}" FontWeight="Bold" Margin="0,0,0,16" />
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Slate100}" BorderThickness="1" CornerRadius="16">
                <StackPanel>
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" Background="{StaticResource Slate100}" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="HQ" Foreground="{StaticResource Slate600}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="音频质量" Foreground="{StaticResource Slate800}" FontWeight="SemiBold" />
                            <TextBlock Text="高 (192K)" Foreground="{StaticResource Slate400}" FontSize="12" />
                        </StackPanel>
                        <SymbolIcon Grid.Column="3" Symbol="Forward" Foreground="{StaticResource Slate300}" VerticalAlignment="Center" />
                    </Grid>
                    <Border BorderBrush="{StaticResource Slate50}" BorderThickness="0,1,0,0" />
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" Background="{StaticResource Slate100}" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <SymbolIcon Symbol="Audio" Foreground="{StaticResource Slate600}" />
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="渐变播放" Foreground="{StaticResource Slate800}" FontWeight="SemiBold" />
                            <TextBlock Text="暂停或开始时音量淡入淡出" Foreground="{StaticResource Slate400}" FontSize="12" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="3" IsOn="True" />
                    </Grid>
                    <Border BorderBrush="{StaticResource Slate50}" BorderThickness="0,1,0,0" />
                    <Grid Padding="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" Background="{StaticResource Slate100}" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <SymbolIcon Symbol="Play" Foreground="{StaticResource Slate600}" />
                        </Border>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="自动播放" Foreground="{StaticResource Slate800}" FontWeight="SemiBold" />
                            <TextBlock Text="收藏列表点击后自动开始播放" Foreground="{StaticResource Slate400}" FontSize="12" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="3" IsOn="True" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="3" Text="外观" Foreground="{StaticResource Rose400}" FontWeight="Bold" Margin="0,40,0,16" />
            <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Slate200}" BorderThickness="1" CornerRadius="32" Padding="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Rose400}" CornerRadius="24" Padding="0,8">
                        <TextBlock Text="自动" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="亮色" Foreground="{StaticResource Slate600}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="深色" Foreground="{StaticResource Slate600}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="5" Text="数据与存储" Foreground="{StaticResource Rose400}" FontWeight="Bold" Margin="0,40,0,16" />
            <Border Grid.Row="6" Background="White" BorderBrush="{StaticResource Slate100}" BorderThickness="1" CornerRadius="16">
                <Grid Padding="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" Background="{StaticResource Slate100}" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Folder" Foreground="{StaticResource Slate600}" />
                    </Border>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="清除缓存" Foreground="{StaticResource Slate800}" FontWeight="SemiBold" />
                        <TextBlock Text="已使用: 42.9 MB" Foreground="{StaticResource Slate400}" FontSize="12" />
                    </StackPanel>
                    <SymbolIcon Grid.Column="3" Symbol="Delete" Foreground="{StaticResource Rose500}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
