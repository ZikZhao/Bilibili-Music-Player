<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="bilibili_music_player_windows.Pages.AudioPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:bilibili_music_player_windows.Pages"    xmlns:helpers="using:bilibili_music_player_windows"    xmlns:models="using:bilibili_music_player_windows.Models"
    xmlns:converters="using:bilibili_music_player_windows.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" Margin="32" Spacing="32" MaxWidth="600">

                <!-- 封面图 -->
                <Border Width="320" Height="200" CornerRadius="16" Background="{ThemeResource Slate200}"
                        AutomationProperties.AutomationId="AudioPlayerCover"
                        HorizontalAlignment="Center">
                    <Border CornerRadius="16">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,320,200" />
                        </Border.Clip>
                        <Image Source="{x:Bind ViewModel.CurrentTrack.Cover, Converter={StaticResource StringToImageSourceConverter}, Mode=OneWay}"
                               Stretch="UniformToFill" />
                    </Border>
                </Border>

                <!-- 标题 + 艺术家 -->
                <StackPanel HorizontalAlignment="Center" Spacing="8" MaxWidth="500">
                    <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Title, Mode=OneWay}"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Foreground="{ThemeResource Slate800}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.CurrentTrack.Artist, Mode=OneWay}"
                               Foreground="{ThemeResource Slate500}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 进度条 -->
                <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                    <Slider Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                            Minimum="0" Maximum="1" StepFrequency="0.001"
                            x:Name="PlayerPageProgressSlider"
                            ManipulationStarted="OnProgressSliderManipulationStarted"
                            ManipulationCompleted="OnProgressSliderManipulationCompleted"
                            AutomationProperties.AutomationId="PlayerPageProgressSlider" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind helpers:ViewHelpers.FormatTimeSpan(ViewModel.Position), Mode=OneWay}"
                                   Foreground="{ThemeResource Slate400}"
                                   FontFamily="Consolas" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind helpers:ViewHelpers.FormatTimeSpan(ViewModel.Duration), Mode=OneWay}"
                                   Foreground="{ThemeResource Slate400}"
                                   FontFamily="Consolas" Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- P8: 播放控制按钮 -->
                <StackPanel HorizontalAlignment="Center" Spacing="24">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">

                        <!-- P8: 播放模式循环 -->
                        <Button Width="40" Height="40" Background="Transparent" BorderThickness="0"
                                Command="{x:Bind ViewModel.CyclePlayModeCommand}"
                                AutomationProperties.AutomationId="CyclePlayModeButton">
                            <Grid>
                                <SymbolIcon Symbol="RepeatAll" Foreground="{ThemeResource Rose400}"
                                            Visibility="{x:Bind local:AudioPlayerPage.PlayModeToVisibility(ViewModel.PlayMode, 0), Mode=OneWay}" />
                                <SymbolIcon Symbol="RepeatOne" Foreground="{ThemeResource Rose400}"
                                            Visibility="{x:Bind local:AudioPlayerPage.PlayModeToVisibility(ViewModel.PlayMode, 1), Mode=OneWay}" />
                                <SymbolIcon Symbol="Shuffle" Foreground="{ThemeResource Rose400}"
                                            Visibility="{x:Bind local:AudioPlayerPage.PlayModeToVisibility(ViewModel.PlayMode, 2), Mode=OneWay}" />
                            </Grid>
                        </Button>

                        <!-- 上一首 -->
                        <Button Width="44" Height="44" Background="Transparent" BorderThickness="0"
                                Command="{x:Bind ViewModel.PreviousCommand}"
                                AutomationProperties.AutomationId="PlayerPagePreviousButton">
                            <SymbolIcon Symbol="Previous" Foreground="{ThemeResource Slate600}" />
                        </Button>

                        <!-- 播放/暂停 -->
                        <Button Width="64" Height="64" Background="{ThemeResource Rose400}" CornerRadius="32"
                                Command="{x:Bind ViewModel.TogglePlayCommand}"
                                AutomationProperties.AutomationId="PlayerPagePlayPauseButton">
                            <Grid>
                                <SymbolIcon Symbol="Play" Foreground="White"
                                            Visibility="{x:Bind helpers:ViewHelpers.InvertBoolToVisibility(ViewModel.IsPlaying), Mode=OneWay}" />
                                <SymbolIcon Symbol="Pause" Foreground="White"
                                            Visibility="{x:Bind helpers:ViewHelpers.BoolToVisibility(ViewModel.IsPlaying), Mode=OneWay}" />
                            </Grid>
                        </Button>

                        <!-- 下一首 -->
                        <Button Width="44" Height="44" Background="Transparent" BorderThickness="0"
                                Command="{x:Bind ViewModel.NextCommand}"
                                AutomationProperties.AutomationId="PlayerPageNextButton">
                            <SymbolIcon Symbol="Next" Foreground="{ThemeResource Slate600}" />
                        </Button>

                        <!-- P7: 播放列表按钮 -->
                        <Button Width="40" Height="40" Background="Transparent" BorderThickness="0"
                                Click="OnTogglePlaylistClick"
                                AutomationProperties.AutomationId="TogglePlaylistButton">
                            <SymbolIcon Symbol="List" Foreground="{ThemeResource Slate400}" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- 音量控制 -->
                <StackPanel Spacing="8" HorizontalAlignment="Stretch" MaxWidth="300">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon Grid.Column="0" Symbol="Volume" Foreground="{ThemeResource Slate400}" />
                        <Slider Grid.Column="1"
                                Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                                Minimum="0" Maximum="1" StepFrequency="0.01"
                                AutomationProperties.AutomationId="PlayerPageVolumeSlider"
                                Margin="12,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind local:AudioPlayerPage.VolumePercent(ViewModel.Volume), Mode=OneWay}"
                                   Foreground="{ThemeResource Slate400}" Style="{StaticResource CaptionTextBlockStyle}"
                                   MinWidth="32" TextAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- P7: 播放列表面板 -->
                <Border x:Name="PlaylistPanel"
                        Visibility="Collapsed"
                        Background="{ThemeResource Slate50}"
                        CornerRadius="12"
                        Padding="16"
                        BorderBrush="{ThemeResource Slate200}"
                        BorderThickness="1"
                        AutomationProperties.AutomationId="PlaylistPanel">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="播放队列" FontWeight="SemiBold"
                                       Foreground="{ThemeResource Slate800}" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.QueueCount, Mode=OneWay}"
                                       Foreground="{ThemeResource Slate400}" Style="{StaticResource CaptionTextBlockStyle}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <ListView ItemsSource="{x:Bind ViewModel.Playlist, Mode=OneWay}"
                                  SelectionMode="None"
                                  MaxHeight="300"
                                  BorderThickness="0"
                                  AutomationProperties.AutomationId="PlaylistListView">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:VideoModel">
                                    <Grid Padding="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                            <Border Width="40" Height="28" CornerRadius="4" Background="{ThemeResource Slate200}">
                                                <Image Source="{x:Bind Cover, Converter={StaticResource StringToImageSourceConverter}, Mode=OneWay}"
                                                       Stretch="UniformToFill" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                           Foreground="{ThemeResource Slate800}"
                                                           FontSize="13" MaxWidth="300"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Artist, Mode=OneWay}"
                                                           Foreground="{ThemeResource Slate500}"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Duration, Mode=OneWay}"
                                                   Foreground="{ThemeResource Slate400}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Button Content="清空队列"
                                Command="{x:Bind ViewModel.ClearPlaylistCommand}"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource Rose400}"
                                Foreground="{ThemeResource Rose400}"
                                CornerRadius="8"
                                Padding="12,6"
                                HorizontalAlignment="Center"
                                AutomationProperties.AutomationId="ClearPlaylistButton" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
