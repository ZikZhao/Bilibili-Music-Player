<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="bilibili_music_player_windows.Pages.AudioPlayerPage"
    Style="{StaticResource AppPageStyle}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:bilibili_music_player_windows.Controls"
    xmlns:local="using:bilibili_music_player_windows.Pages"
    xmlns:helpers="using:bilibili_music_player_windows"
    xmlns:models="using:bilibili_music_player_windows.Models"
    xmlns:converters="using:bilibili_music_player_windows.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
        <converters:VolumePercentConverter x:Key="VolumeTooltipConverter" />
    </Page.Resources>

    <Grid x:Name="PlayerRoot" Background="#FF24222A" RequestedTheme="Dark" AutomationProperties.AutomationId="ExpandedPlayer">
        <controls:BlurredCoverBackground x:Name="CoverBackdrop" Source="{Binding CurrentTrack.Cover}"
                                        AutomationProperties.AutomationId="PlayerBackdrop" />
        <Border IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#99000000" Offset="0" />
                    <GradientStop Color="#99000000" Offset="0.45" />
                    <GradientStop Color="#CC000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <ScrollViewer Margin="32" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto"
                      VerticalContentAlignment="Center">
            <StackPanel HorizontalAlignment="Center" Spacing="24" MaxWidth="600">

                <!-- 封面图 -->
                <controls:AspectRatioPanel MaxWidth="320"
                        AutomationProperties.AutomationId="AudioPlayerCover"
                        HorizontalAlignment="Stretch">
                    <Border CornerRadius="16" Background="{ThemeResource Slate200}" />
                    <Border CornerRadius="16"><Border.Background>
                        <ImageBrush ImageSource="{Binding CurrentTrack.Cover, Converter={StaticResource StringToImageSourceConverter}}"
                                    Stretch="UniformToFill" />
                    </Border.Background></Border>
                </controls:AspectRatioPanel>

                <!-- 标题 + 艺术家 -->
                <StackPanel HorizontalAlignment="Center" Spacing="8" MaxWidth="500">
                    <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Foreground="{ThemeResource Slate800}"
                               TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentTrack.Artist}"
                               Foreground="#D9FFFFFF"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 进度条 -->
                <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                    <Slider Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
                            Minimum="0" Maximum="1" StepFrequency="0.001"
                            x:Name="PlayerPageProgressSlider"
                            IsThumbToolTipEnabled="True"
                            Loaded="OnPlayerPageLoaded"
                            AutomationProperties.AutomationId="PlayerPageProgressSlider" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind helpers:ViewHelpers.FormatTimeSpan(ViewModel.Position), Mode=OneWay}"
                                   Foreground="#D9FFFFFF"
                                   FontFamily="Arial" FontSize="14" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind helpers:ViewHelpers.FormatTimeSpan(ViewModel.Duration), Mode=OneWay}"
                                   Foreground="#D9FFFFFF"
                                   FontFamily="Arial" FontSize="14"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <!-- P8: 播放控制按钮 -->
                <StackPanel HorizontalAlignment="Center" Spacing="24">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">

                        <!-- P8: 播放模式循环 -->
                        <Button Width="40" Height="40" Background="Transparent" BorderThickness="0"
                                Command="{x:Bind ViewModel.CyclePlayModeCommand}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.PlayModeLabel, Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind ViewModel.PlayModeLabel, Mode=OneWay}"
                                AutomationProperties.AutomationId="CyclePlayModeButton">
                            <Grid>
                                <controls:Icon Glyph="{StaticResource Icon_PlayCycle}" FontSize="20"
                                           Visibility="{x:Bind local:AudioPlayerPage.PlayModeToVisibility(ViewModel.PlayMode, 0), Mode=OneWay}" />
                                <controls:Icon Glyph="{StaticResource Icon_PlayOnce}" FontSize="20"
                                           Visibility="{x:Bind local:AudioPlayerPage.PlayModeToVisibility(ViewModel.PlayMode, 1), Mode=OneWay}" />
                            </Grid>
                        </Button>

                        <!-- 上一首 -->
                        <Button Width="44" Height="44" Background="Transparent" BorderThickness="0"
                                Command="{x:Bind ViewModel.PreviousCommand}"
                                AutomationProperties.AutomationId="PlayerPagePreviousButton">
                            <controls:Icon Glyph="{StaticResource Icon_GoStart}" FontSize="28" />
                        </Button>

                        <!-- 播放/暂停 -->
                        <Button Width="64" Height="64" Background="{ThemeResource Rose400}" CornerRadius="32"
                                Command="{x:Bind ViewModel.TogglePlayCommand}"
                                AutomationProperties.AutomationId="PlayerPagePlayPauseButton">
                            <Grid>
                                <controls:Icon Glyph="{StaticResource Icon_PlayOne}" FontSize="32"
                                           Visibility="{x:Bind helpers:ViewHelpers.InvertBoolToVisibility(ViewModel.ShowPause), Mode=OneWay}" />
                                <controls:Icon Glyph="{StaticResource Icon_Pause}" FontSize="32"
                                           Visibility="{x:Bind helpers:ViewHelpers.BoolToVisibility(ViewModel.ShowPause), Mode=OneWay}" />
                            </Grid>
                        </Button>

                        <!-- 下一首 -->
                        <Button Width="44" Height="44" Background="Transparent" BorderThickness="0"
                                Command="{x:Bind ViewModel.NextCommand}"
                                AutomationProperties.AutomationId="PlayerPageNextButton">
                            <controls:Icon Glyph="{StaticResource Icon_GoEnd}" FontSize="28" />
                        </Button>

                        <!-- P7: 播放列表按钮 -->
                        <Button Width="40" Height="40" Background="Transparent" BorderThickness="0"
                                Click="OnShowPlaylistClick" ToolTipService.ToolTip="播放列表" AutomationProperties.Name="播放列表"
                                AutomationProperties.AutomationId="TogglePlaylistButton">
                            <controls:Icon Glyph="{StaticResource Icon_MusicList}" FontSize="24" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- 音量控制 -->
                <StackPanel Spacing="8" HorizontalAlignment="Stretch" MaxWidth="300">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:Icon Grid.Column="0" Glyph="{StaticResource Icon_VolumeNotice}" FontSize="20" />
                        <Slider Grid.Column="1"
                                Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                                ThumbToolTipValueConverter="{StaticResource VolumeTooltipConverter}"
                                Minimum="0" Maximum="1" StepFrequency="0.01" SmallChange="0.01" LargeChange="0.1"
                                AutomationProperties.AutomationId="PlayerPageVolumeSlider"
                                Margin="12,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind local:AudioPlayerPage.VolumePercent(ViewModel.Volume), Mode=OneWay}"
                                   Foreground="#D9FFFFFF" Style="{StaticResource CaptionTextBlockStyle}"
                                   MinWidth="32" TextAlignment="Right" />
                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
