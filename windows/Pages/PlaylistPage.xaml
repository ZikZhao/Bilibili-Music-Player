<Page x:Class="bilibili_music_player_windows.Pages.PlaylistPage" Style="{StaticResource AppPageStyle}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:bilibili_music_player_windows.Controls"
    xmlns:models="using:bilibili_music_player_windows.Models"
    xmlns:helpers="using:bilibili_music_player_windows">
    <Grid Margin="{StaticResource PageContentMargin}" AutomationProperties.AutomationId="PlaylistPage">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactQueue">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="WideQueue">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="850" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="HeaderArtistColumn.Width" Value="160" />
                        <Setter Target="HeaderArtist.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource PageHeaderStyle}">
        <TextBlock x:Name="PageTitle" Text="播放列表" Style="{StaticResource PageTitleTextBlockStyle}" AutomationProperties.AutomationId="PageTitle" />
        <TextBlock Text="{x:Bind ViewModel.QueueSummary, Mode=OneWay}" VerticalAlignment="Center"
                   HorizontalAlignment="Right" Foreground="{ThemeResource Slate500}" />
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox SelectedIndex="{x:Bind ViewModel.PlayModeIndex, Mode=TwoWay}" MinWidth="128"
                          AutomationProperties.Name="播放模式" AutomationProperties.AutomationId="QueuePlayMode">
                    <ComboBoxItem Content="列表循环" /><ComboBoxItem Content="单曲循环" />
                </ComboBox>
                <Button Command="{x:Bind ViewModel.ShuffleUpcomingCommand}" AutomationProperties.AutomationId="ShuffleQueueButton"
                        ToolTipService.ToolTip="打乱接下来播放的曲目，保留当前曲目">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <controls:Icon Glyph="{StaticResource Icon_Shuffle}" FontSize="16" /><TextBlock Text="打乱" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.ClearPlaylistCommand}" Content="清空" AutomationProperties.AutomationId="ClearQueueButton" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" RowSpacing="8" Visibility="{x:Bind helpers:ViewHelpers.BoolToVisibility(ViewModel.HasQueue), Mode=OneWay}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Padding="12,0,12,8" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" /><ColumnDefinition Width="64" /><ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="HeaderArtistColumn" Width="0" /><ColumnDefinition Width="56" /><ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="序号" FontSize="12" Foreground="{ThemeResource Slate500}" />
                <TextBlock Grid.Column="2" Text="曲目" FontSize="12" Foreground="{ThemeResource Slate500}" />
                <TextBlock x:Name="HeaderArtist" Grid.Column="3" Text="UP 主" FontSize="12" Foreground="{ThemeResource Slate500}" Visibility="Collapsed" />
                <TextBlock Grid.Column="4" Text="时长" FontSize="12" Foreground="{ThemeResource Slate500}" HorizontalAlignment="Right" />
            </Grid>
            <ListView x:Name="QueueList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Playlist}" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="OnQueueItemClick" AutomationProperties.AutomationId="QueueRows">
                <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style></ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaybackQueueEntry">
                        <controls:PlaybackQueueRow RemoveRequested="OnRemoveClick" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                    Visibility="{x:Bind helpers:ViewHelpers.InvertBoolToVisibility(ViewModel.HasQueue), Mode=OneWay}">
            <controls:Icon Glyph="{StaticResource Icon_MusicList}" FontSize="40" Foreground="{ThemeResource Slate400}" />
            <TextBlock Text="播放列表为空" FontSize="20" HorizontalAlignment="Center" />
            <TextBlock Text="从我的收藏中播放歌曲或加入队列" Foreground="{ThemeResource Slate500}" />
        </StackPanel>
    </Grid>
</Page>
