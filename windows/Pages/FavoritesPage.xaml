<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="bilibili_music_player_windows.Pages.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:bilibili_music_player_windows.ViewModels"
    xmlns:controls="using:bilibili_music_player_windows.Controls"
    xmlns:converters="using:bilibili_music_player_windows.Converters">
    <Page.Resources>
        <converters:StringToImageSourceConverter x:Key="CoverConverter" />
    </Page.Resources>
    <Grid x:Name="LibraryPageRoot" Margin="28,20,28,20" RowSpacing="12">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactLibrary">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavigationColumn.Width" Value="0" />
                        <Setter Target="LibraryNavigationHost.Visibility" Value="Collapsed" />
                        <Setter Target="NavigationPicker.Visibility" Value="Visible" />
                        <Setter Target="LibraryBody.ColumnSpacing" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLibrary">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="850" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="NavigationColumn.Width" Value="220" />
                        <Setter Target="LibraryNavigationHost.Visibility" Value="Visible" />
                        <Setter Target="NavigationPicker.Visibility" Value="Collapsed" />
                        <Setter Target="LibraryBody.ColumnSpacing" Value="20" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="我的收藏" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{x:Bind ViewModel.AccountButtonLabel, Mode=OneWay}" Click="OnAccountClick"
                    VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}" AutomationProperties.AutomationId="LibraryAccountButton" />
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{x:Bind ViewModel.AccountLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource Slate600}" />
                <TextBlock Text="{x:Bind ViewModel.SyncStatus, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource Slate500}" FontSize="12"
                           AutomationProperties.AutomationId="LibrarySyncStatus" />
            </StackPanel>
            <Button Grid.Column="1" Content="同步" Click="OnSyncClick" Visibility="{x:Bind ViewModel.SignedInVisibility, Mode=OneWay}"
                    VerticalAlignment="Center" AutomationProperties.AutomationId="LibrarySyncButton" />
        </Grid>
        <StackPanel Grid.Row="2" Spacing="8">
            <InfoBar IsOpen="True" IsClosable="False" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" />
            <StackPanel Visibility="{x:Bind ViewModel.ConflictVisibility, Mode=OneWay}" Spacing="8">
                <TextBlock Text="云端和本机都有修改。两个版本都已保留，请选择本次要使用的版本。" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="保留本机版本" Click="OnKeepLocalClick" />
                    <Button Content="使用云端版本" Click="OnUseCloudClick" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <ContentControl Grid.Row="3" IsEnabled="{x:Bind ViewModel.IsReady, Mode=OneWay}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid x:Name="LibraryBody" ColumnSpacing="20">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid x:Name="LibraryNavigationHost" RowSpacing="8" BorderBrush="{ThemeResource Slate200}" BorderThickness="0,0,1,0" Padding="0,0,12,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="收藏库" FontWeight="SemiBold" Margin="8,8,0,0" />
                <TreeView x:Name="LibraryTree" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Roots}" ItemInvoked="OnTreeInvoked"
                          SelectionMode="Single" CanDragItems="False" CanReorderItems="False" AutomationProperties.AutomationId="LibraryTree">
                    <TreeView.Resources>
                        <StaticResource x:Key="TreeViewItemSelectionIndicatorForeground" ResourceKey="Rose400" />
                        <StaticResource x:Key="TreeViewItemSelectionIndicatorForegroundPointerOver" ResourceKey="Rose400" />
                        <StaticResource x:Key="TreeViewItemSelectionIndicatorForegroundPressed" ResourceKey="Rose400" />
                    </TreeView.Resources>
                    <TreeView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LibraryNavItem">
                            <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" IsSelected="{x:Bind IsSelected, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Bind Name}">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </TreeViewItem>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <ComboBox x:Name="NavigationPicker" ItemsSource="{x:Bind ViewModel.NavigationChoices}"
                              DisplayMemberPath="Name" SelectionChanged="OnNavigationPicked" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="收藏库位置" />
                    <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="LibraryHeading" />
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Foreground="{ThemeResource Slate500}" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
                <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Background="Transparent" HorizontalContentAlignment="Left">
                    <AppBarButton Icon="Play" Label="播放全部" Click="OnPlayAllClick" AutomationProperties.AutomationId="LibraryPlayAll" />
                    <AppBarButton Icon="Add" Label="加入队列" Click="OnAppendAllClick" />
                    <AppBarButton Label="新建" AutomationProperties.AutomationId="LibraryCreateButton">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8F4;" /></AppBarButton.Icon>
                        <AppBarButton.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="新建歌单" Tag="playlist" Click="OnCreateClick" />
                            <MenuFlyoutItem Text="新建文件夹" Tag="folder" Click="OnCreateClick" />
                        </MenuFlyout></AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton Label="添加内容" IsEnabled="{x:Bind ViewModel.IsPlaylist, Mode=OneWay}" AutomationProperties.AutomationId="LibraryAddContentButton">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                        <AppBarButton.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="从收藏库添加歌曲" Click="OnAddTracksClick" />
                            <MenuFlyoutItem Text="动态链接其他歌单" Click="OnAddLinkClick" />
                            <MenuFlyoutItem Text="复制其他歌单的歌曲" Click="OnCopyPlaylistClick" />
                        </MenuFlyout></AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton Label="管理" IsEnabled="{x:Bind ViewModel.IsNode, Mode=OneWay}">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE712;" /></AppBarButton.Icon>
                        <AppBarButton.Flyout><MenuFlyout>
                            <MenuFlyoutItem Text="重命名" Click="OnRenameClick" />
                            <MenuFlyoutItem Text="移动到文件夹" Click="OnMoveClick" />
                            <MenuFlyoutItem Text="向上排列" Tag="-1" Click="OnReorderNodeClick" />
                            <MenuFlyoutItem Text="向下排列" Tag="1" Click="OnReorderNodeClick" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="删除" Click="OnDeleteClick" />
                        </MenuFlyout></AppBarButton.Flyout>
                    </AppBarButton>
                </CommandBar>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <CheckBox Content="展开动态链接" IsChecked="{x:Bind ViewModel.ExpandLinks, Mode=TwoWay}"
                              ToolTipService.ToolTip="关闭展开后，可管理动态链接及条目顺序。"
                              Visibility="{x:Bind ViewModel.PlaylistToolsVisibility, Mode=OneWay}" AutomationProperties.AutomationId="LibraryExpandLinks" />
                    <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.SortOptions}" SelectedItem="{x:Bind ViewModel.SortOption, Mode=TwoWay}"
                              Visibility="{x:Bind ViewModel.TrackSortVisibility, Mode=OneWay}"
                              MinWidth="120" AutomationProperties.AutomationId="SortComboBox" />
                </Grid>
                <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                            Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                    <FontIcon Glyph="&#xE8D6;" FontSize="36" Foreground="{ThemeResource Slate400}" />
                    <TextBlock Text="这里还没有内容" HorizontalAlignment="Center" />
                    <TextBlock Text="搜索并收藏音乐，或新建歌单和文件夹。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource Slate500}" />
                </StackPanel>
                <ListView x:Name="LibraryRows" Grid.Row="3" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="OnRowClick" AutomationProperties.AutomationId="LibraryRows"
                          Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
                    <ListView.ItemContainerStyle><Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style></ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:LibraryDisplayRow">
                            <Grid Padding="8,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                <controls:AspectRatioPanel Width="64" VerticalAlignment="Center">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="22" Foreground="{ThemeResource Slate500}" />
                                    <Border CornerRadius="4"><Border.Background><ImageBrush ImageSource="{x:Bind Cover, Converter={StaticResource CoverConverter}}" Stretch="UniformToFill" /></Border.Background></Border>
                                </controls:AspectRatioPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Subtitle}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource Slate500}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind Duration}" VerticalAlignment="Center" Foreground="{ThemeResource Slate500}" FontSize="12" />
                                <Button Grid.Column="3" Width="32" Height="32" Padding="0" VerticalAlignment="Center" Click="OnRowMenuClick"
                                        Style="{StaticResource SubtleButtonStyle}" AutomationProperties.Name="更多操作">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
        </ContentControl>
    </Grid>
</Page>
