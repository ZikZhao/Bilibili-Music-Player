<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="bilibili_music_player_windows.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:bilibili_music_player_windows.Pages"
    xmlns:models="using:bilibili_music_player_windows.Models"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Disabled">

    <Grid>
        <!-- ════════════════════════════════════════════════ -->
        <!-- LAYER 1: 搜索模式（非预览时显示）                 -->
        <!-- ════════════════════════════════════════════════ -->
        <Grid Visibility="{x:Bind ViewModel.SearchModeVisibility, Mode=OneWay}">
            <ScrollViewer x:Name="MainScrollViewer">
                <StackPanel Margin="32" Spacing="24">
                <!-- 标题 -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Rectangle Width="4" Height="28" Fill="{StaticResource Rose400}" VerticalAlignment="Center" RadiusX="2" RadiusY="2" Margin="0,2,0,0" />
                    <TextBlock Text="搜索音乐" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Slate800}" />
                </StackPanel>

                <!-- 搜索框区域（含建议下拉） -->
                <Grid>
                    <StackPanel Spacing="0">
                        <Border Background="{StaticResource Slate100}" CornerRadius="12,12,0,0" Padding="12,8">
                            <TextBox x:Name="SearchBox" PlaceholderText="搜索 Bilibili 音乐视频" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Slate800}" PlaceholderForeground="{StaticResource Slate400}"
                                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                                     KeyDown="OnSearchKeyDown" />
                        </Border>

                        <!-- 搜索建议下拉列表 S3 -->
                        <ListView x:Name="SuggestionsList"
                                  ItemsSource="{x:Bind ViewModel.Suggestions, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.SuggestionsVisibility, Mode=OneWay}"
                                  MaxHeight="300"
                                  BorderBrush="{StaticResource Slate200}"
                                  BorderThickness="1"
                                  CornerRadius="0,0,12,12"
                                  Background="White"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="OnSuggestionClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:SuggestionModel">
                                    <Grid Padding="12,8">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" Foreground="{StaticResource Slate800}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>

                <!-- 搜索历史 -->
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Find" Foreground="{StaticResource Slate600}" />
                            <TextBlock Text="搜索历史" Foreground="{StaticResource Slate600}" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button x:Name="ClearHistoryButton" Grid.Column="1" Content="清空" Foreground="{StaticResource Slate400}" Background="Transparent" BorderThickness="0" IsEnabled="False" Command="{x:Bind ViewModel.ClearHistoryCommand}" />
                    </Grid>

                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Padding="0">
                        <controls:ItemsRepeater ItemsSource="{x:Bind ViewModel.SearchHistory, Mode=OneWay}">
                            <controls:ItemsRepeater.Layout>
                                <controls:StackLayout Orientation="Horizontal" Spacing="8" />
                            </controls:ItemsRepeater.Layout>
                            <controls:ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Padding="0" Background="Transparent" BorderThickness="0" Click="OnKeywordClick">
                                        <Border Background="{StaticResource Slate100}" CornerRadius="8" Padding="16,8" Margin="0">
                                            <TextBlock Text="{x:Bind Mode=OneWay}" Foreground="{StaticResource Slate600}" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </controls:ItemsRepeater.ItemTemplate>
                        </controls:ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <!-- 热门搜索 -->
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Favorite" Foreground="{StaticResource Slate600}" />
                        <TextBlock Text="热门搜索" Foreground="{StaticResource Slate600}" FontWeight="SemiBold" />
                    </StackPanel>

                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Padding="0">
                        <controls:ItemsRepeater ItemsSource="{x:Bind ViewModel.HotKeywords, Mode=OneWay}">
                            <controls:ItemsRepeater.Layout>
                                <controls:StackLayout Orientation="Horizontal" Spacing="8" />
                            </controls:ItemsRepeater.Layout>
                            <controls:ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Padding="0" Background="Transparent" BorderThickness="0" Click="OnKeywordClick">
                                        <Border Background="{StaticResource Slate100}" CornerRadius="8" Padding="16,8" Margin="0">
                                            <TextBlock Text="{x:Bind Mode=OneWay}" Foreground="{StaticResource Slate600}" />
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </controls:ItemsRepeater.ItemTemplate>
                        </controls:ItemsRepeater>
                    </ScrollViewer>
                </StackPanel>

                <!-- 加载指示器 -->
                <StackPanel HorizontalAlignment="Center" Visibility="{x:Bind ViewModel.IsSearchingVisibility, Mode=OneWay}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" Width="32" Height="32" />
                    <TextBlock Text="搜索中..." Foreground="{StaticResource Slate500}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>

                <!-- 错误状态 UI S7 -->
                <Border Visibility="{x:Bind ViewModel.ErrorMessageVisibility, Mode=OneWay}"
                        Background="{StaticResource Slate50}"
                        CornerRadius="12"
                        Padding="24"
                        BorderBrush="{StaticResource Rose200}"
                        BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="⚠" Foreground="{StaticResource Rose400}" HorizontalAlignment="Center" FontSize="24" />
                        <TextBlock x:Name="ErrorTextBlock"
                                   Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                   Foreground="{StaticResource Rose500}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Content="重试"
                                Foreground="White"
                                Background="{StaticResource Rose400}"
                                CornerRadius="8"
                                Padding="16,8"
                                HorizontalAlignment="Center"
                                Command="{x:Bind ViewModel.RefreshCommand}" />
                    </StackPanel>
                </Border>

                <!-- 搜索结果标题 -->
                <TextBlock Text="搜索结果" Foreground="{StaticResource Rose400}" FontWeight="Bold" Margin="0,8,0,0" />

                <!-- 搜索结果网格 -->
                <GridView
                    ItemsSource="{x:Bind ViewModel.SearchVideos, Mode=OneWay}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="OnVideoClick"
                    BorderThickness="0">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,16,16" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Width" Value="260" />
                            <Setter Property="Height" Value="230" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="models:VideoPreviewItem">
                            <Border Background="White" BorderBrush="{StaticResource Slate200}" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Border Background="{StaticResource Slate200}" CornerRadius="6,6,0,0" />
                                        <Border CornerRadius="6,6,0,0">
                                            <Border.Background>
                                                <ImageBrush Stretch="UniformToFill">
                                                    <ImageBrush.ImageSource>
                                                        <BitmapImage UriSource="{x:Bind CoverUri, Mode=OneWay}" />
                                                    </ImageBrush.ImageSource>
                                                </ImageBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border Background="#99000000" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Padding="6,2">
                                            <TextBlock Text="{x:Bind Duration, Mode=OneWay}" Foreground="White" FontSize="10" FontFamily="Consolas" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Padding="12,12,12,12" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Foreground="{StaticResource Slate800}" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                        <TextBlock Text="{x:Bind Author, Mode=OneWay}" Foreground="{StaticResource Slate500}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Views, Mode=OneWay}" Foreground="{StaticResource Slate400}" FontSize="11" Margin="0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- 加载更多按钮 S4 -->
                <Button x:Name="LoadMoreButton"
                        Content="加载更多"
                        Visibility="{x:Bind ViewModel.HasMoreVisibility, Mode=OneWay}"
                        Command="{x:Bind ViewModel.LoadMoreCommand}"
                        HorizontalAlignment="Center"
                        Background="{StaticResource Slate100}"
                        Foreground="{StaticResource Slate600}"
                        CornerRadius="8"
                        Padding="24,12"
                        BorderThickness="0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ════════════════════════════════════════════════ -->
        <!-- LAYER 2: 全屏预览模式（左视频 + 右侧信息+列表）  -->
        <!-- ════════════════════════════════════════════════ -->
        <Grid Visibility="{x:Bind ViewModel.PreviewModeVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- ── 左侧：视频播放器 ── -->
            <Grid Background="Black">
                <MediaPlayerElement x:Name="PreviewPlayer"
                                    AutoPlay="True"
                                    AreTransportControlsEnabled="True"
                                    Stretch="Uniform" />

                <!-- 返回按钮 -->
                <Button x:Name="ClosePreviewButton"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="16"
                        Width="40"
                        Height="40"
                        Background="#66000000"
                        CornerRadius="20"
                        BorderThickness="0"
                        Click="OnClosePreviewClick"
                        AutomationProperties.AutomationId="ClosePreviewButton">
                    <SymbolIcon Symbol="Cancel" Foreground="White" />
                </Button>
            </Grid>

            <!-- ── 右侧：视频信息 + 搜索结果列表 ── -->
            <Grid Grid.Column="1" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ── 顶部：视频信息 ── -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Padding="24,20,24,16" Spacing="12">
                        <!-- 标题 -->
                        <TextBlock x:Name="PreviewTitleText"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate800}"
                                   TextWrapping="Wrap"
                                   MaxLines="3" />

                        <!-- 分隔线 -->
                        <Rectangle Height="1" Fill="{StaticResource Slate100}" />

                        <!-- UP 主信息 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource Rose100}">
                                <TextBlock Text="UP" Foreground="{StaticResource Rose500}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PreviewAuthorText"
                                           Text="UP 主"
                                           Foreground="{StaticResource Slate800}"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="PreviewMetaText"
                                           Foreground="{StaticResource Slate400}"
                                           FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <!-- 统计信息 -->
                        <Grid ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <SymbolIcon Symbol="Play" Foreground="{StaticResource Slate400}" />
                                <TextBlock x:Name="PreviewViewsText"
                                           Foreground="{StaticResource Slate500}"
                                           FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <SymbolIcon Symbol="Clock" Foreground="{StaticResource Slate400}" />
                                <TextBlock x:Name="PreviewDurationText"
                                           Foreground="{StaticResource Slate500}"
                                           FontSize="12" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                <SymbolIcon Symbol="Like" Foreground="{StaticResource Slate400}" />
                                <TextBlock x:Name="PreviewLikesText"
                                           Foreground="{StaticResource Slate500}"
                                           FontSize="12" />
                            </StackPanel>
                        </Grid>

                        <!-- 收藏按钮 -->
                        <Button x:Name="FavoriteButton"
                                Background="{StaticResource Slate50}"
                                BorderThickness="0"
                                CornerRadius="8"
                                Padding="12,8"
                                HorizontalAlignment="Stretch"
                                Click="OnToggleFavoriteClick"
                                AutomationProperties.AutomationId="PreviewFavoriteButton">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <SymbolIcon x:Name="FavoriteButtonIcon"
                                            Symbol="OutlineStar"
                                            Foreground="{StaticResource Rose400}" />
                                <TextBlock x:Name="FavoriteButtonText"
                                           Text="收藏"
                                           Foreground="{StaticResource Rose400}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <!-- 分隔线 -->
                        <Rectangle Height="1" Fill="{StaticResource Slate100}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ── 底部：搜索结果列表（可滚动） ── -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 列表标题 -->
                    <Border Background="{StaticResource Slate50}" Padding="24,12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Find" Foreground="{StaticResource Slate600}" />
                            <TextBlock Foreground="{StaticResource Slate600}" FontWeight="SemiBold" FontSize="13">
                                <Run Text="搜索结果" />
                                <Run Text="{x:Bind ViewModel.TotalResults, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 搜索结果列表 -->
                    <ListView Grid.Row="1"
                              x:Name="PreviewSearchResultsList"
                              ItemsSource="{x:Bind ViewModel.SearchVideos, Mode=OneWay}"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="OnPreviewResultClick"
                              BorderThickness="0"
                              AutomationProperties.AutomationId="PreviewSearchResultsList">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:VideoPreviewItem">
                                <Grid Padding="12,8"
                                      BorderBrush="{StaticResource Slate100}"
                                      BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 封面 -->
                                    <Border Width="100" Height="60" CornerRadius="4" Background="{StaticResource Slate200}">
                                        <Grid>
                                            <Border CornerRadius="4">
                                                <Border.Background>
                                                    <ImageBrush Stretch="UniformToFill">
                                                        <ImageBrush.ImageSource>
                                                            <BitmapImage UriSource="{x:Bind CoverUri, Mode=OneWay}" />
                                                        </ImageBrush.ImageSource>
                                                    </ImageBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border Background="#99000000" CornerRadius="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" Padding="4,1">
                                                <TextBlock Text="{x:Bind Duration, Mode=OneWay}" Foreground="White" FontSize="10" FontFamily="Consolas" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 文字信息 -->
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                                   Foreground="{StaticResource Slate800}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="2" />
                                        <TextBlock Text="{x:Bind Author, Mode=OneWay}"
                                                   Foreground="{StaticResource Slate500}"
                                                   FontSize="11" />
                                        <TextBlock Text="{x:Bind Views, Mode=OneWay}"
                                                   Foreground="{StaticResource Slate400}"
                                                   FontSize="10" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
