<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="bilibili_music_player_windows.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:bilibili_music_player_windows.Models"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="32" Spacing="24">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Rectangle Width="4" Height="28" Fill="{StaticResource Rose400}" VerticalAlignment="Center" RadiusX="2" RadiusY="2" Margin="0,2,0,0" />
                <TextBlock Text="搜索音乐" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Slate800}" />
            </StackPanel>

            <Border Background="{StaticResource Slate100}" CornerRadius="12" Padding="12,8">
                <TextBox x:Name="SearchBox" PlaceholderText="搜索 Bilibili 音乐视频" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Slate800}" PlaceholderForeground="{StaticResource Slate400}" KeyDown="OnSearchKeyDown" />
            </Border>

            <StackPanel Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Find" Foreground="{StaticResource Slate600}" />
                        <TextBlock Text="搜索历史" Foreground="{StaticResource Slate600}" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button x:Name="ClearHistoryButton" Grid.Column="1" Content="清空" Foreground="{StaticResource Slate400}" Background="Transparent" BorderThickness="0" IsEnabled="False" Click="OnClearHistoryClick" />
                </Grid>

                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Padding="0">
                    <controls:ItemsRepeater ItemsSource="{x:Bind ViewModel.SearchHistory}">
                        <controls:ItemsRepeater.Layout>
                            <controls:StackLayout Orientation="Horizontal" Spacing="8" />
                        </controls:ItemsRepeater.Layout>
                        <controls:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Padding="0" Background="Transparent" BorderThickness="0" Click="OnKeywordClick">
                                    <Border Background="{StaticResource Slate100}" CornerRadius="8" Padding="16,8" Margin="0">
                                        <TextBlock Text="{x:Bind}" Foreground="{StaticResource Slate600}" />
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </controls:ItemsRepeater.ItemTemplate>
                    </controls:ItemsRepeater>
                </ScrollViewer>
            </StackPanel>

            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Favorite" Foreground="{StaticResource Slate600}" />
                    <TextBlock Text="热门搜索" Foreground="{StaticResource Slate600}" FontWeight="SemiBold" />
                </StackPanel>

                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Padding="0">
                    <controls:ItemsRepeater ItemsSource="{x:Bind ViewModel.HotKeywords}">
                        <controls:ItemsRepeater.Layout>
                            <controls:StackLayout Orientation="Horizontal" Spacing="8" />
                        </controls:ItemsRepeater.Layout>
                        <controls:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Padding="0" Background="Transparent" BorderThickness="0" Click="OnKeywordClick">
                                    <Border Background="{StaticResource Slate100}" CornerRadius="8" Padding="16,8" Margin="0">
                                        <TextBlock Text="{x:Bind}" Foreground="{StaticResource Slate600}" />
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </controls:ItemsRepeater.ItemTemplate>
                    </controls:ItemsRepeater>
                </ScrollViewer>
            </StackPanel>

            <TextBlock Text="搜索结果" Foreground="{StaticResource Rose400}" FontWeight="Bold" Margin="0,8,0,0" />

            <GridView
                ItemsSource="{x:Bind ViewModel.SearchVideos}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="OnVideoClick"
                BorderThickness="0">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="0,0,16,16" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Width" Value="260" />
                        <Setter Property="Height" Value="230" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:VideoPreviewItem">
                        <Border Background="White" BorderBrush="{StaticResource Slate200}" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Border Background="{StaticResource Slate200}" CornerRadius="6,6,0,0" />
                                    <Border CornerRadius="6,6,0,0">
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill">
                                                <ImageBrush.ImageSource>
                                                    <BitmapImage UriSource="{x:Bind CoverUri}" />
                                                </ImageBrush.ImageSource>
                                            </ImageBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border Background="#99000000" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8" Padding="6,2">
                                        <TextBlock Text="{x:Bind Duration}" Foreground="White" FontSize="10" FontFamily="Consolas" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Padding="12,12,12,12" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}" Foreground="{StaticResource Slate800}" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                    <TextBlock Text="{x:Bind Author}" Foreground="{StaticResource Slate500}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Views}" Foreground="{StaticResource Slate400}" FontSize="11" Margin="0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>

        <ContentDialog
            x:Name="PreviewDialog"
            Title="视频预览"
            CloseButtonText="关闭"
            Closed="OnPreviewDialogClosed">
            <StackPanel Spacing="12">
                <TextBlock x:Name="PreviewTitleText" FontWeight="Bold" Foreground="{StaticResource Slate800}" TextWrapping="Wrap" />
                <TextBlock x:Name="PreviewMetaText" Foreground="{StaticResource Slate500}" FontSize="12" />
                <MediaPlayerElement x:Name="PreviewPlayer" Height="360" AreTransportControlsEnabled="True" AutoPlay="True" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
