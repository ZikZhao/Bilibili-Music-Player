<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="bilibili_music_player_windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:bilibili_music_player_windows"
    xmlns:controls="using:bilibili_music_player_windows.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="AppFontFamily">Microsoft YaHei</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>
            <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource TitleTextBlockFontSize}" />
                <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
            </Style>
            <FontFamily x:Key="IconParkFontFamily">ms-appx:///Assets/IconPark.ttf#IconPark</FontFamily>
            <Style TargetType="controls:Icon">
                <Setter Property="Foreground" Value="{ThemeResource Slate800}" />
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Assets/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light" Source="Themes/LightColors.xaml" />
                <ResourceDictionary x:Key="Dark" Source="Themes/DarkColors.xaml" />
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
